{{> header activeGames=true}}

<main class="main-panel container mt-5">

    <a href="/games" class="btn-outline-light" style="text-decoration:none; display:inline-flex; margin-bottom:22px;">
        ← Volver a la galería
    </a>

    <div class="detail-panel d-flex flex-column flex-md-row gap-4">

        <div class="detail-media text-center mx-auto mx-md-0">
            <img
                src="/thumbnails/{{game.id_game}}.png"
                alt="{{game.game_name}}"
                class="thumbnail"
                onerror="this.onerror=null;this.src='/img/default_game.png';">
        </div>

        <div class="flex-grow-1">

            <h1 class="text-primary">
                {{game.game_name}}
            </h1>

            <div class="detail-meta">
                <span class="meta-chip"><strong>Autor:</strong> {{game.author_name}}</span>
                <span class="meta-chip"><strong>Actualizado:</strong> {{game.updated_at}}</span>
                <span class="meta-chip"><strong>Creado:</strong> {{game.created_at}}</span>
            </div>

            <p class="detail-description">
                {{#if game.game_description}}
                    {{game.game_description}}
                {{else}}
                    <em>Este juego no tiene descripción.</em>
                {{/if}}
            </p>

            <div class="detail-actions">

                <a href="{{gamesOrigin}}/{{game.id_game}}/{{game.entry_file}}" class="btn btn-primary">
                    <img class="icon" src="/icons/play.svg" alt="">Jugar
                </a>

                {{#if isFavorite}}
                    <form
                        action="/favorites/{{game.id_game}}?_method=DELETE"
                        method="POST"
                        class="inline-form">

                        <button type="submit" class="btn btn-danger">
                            Quitar de favoritos
                        </button>
                    </form>
                {{else}}
                    <form
                        action="/favorites/{{game.id_game}}"
                        method="POST"
                        class="inline-form">

                        <button type="submit" class="btn btn-primary">
                            <img class="icon" src="/icons/heart.svg" alt="">
                            Añadir a favoritos
                        </button>
                    </form>
                {{/if}}

                {{#if isOwner}}
                    <a href="/games/game-details/{{game.id_game}}/edit" class="btn btn-outline-light">
                        ✎ Editar
                    </a>
                {{/if}}

                {{#if canDelete}}
                    <form action="/games/{{game.id_game}}?_method=DELETE" method="POST"
                        data-confirm="¿Seguro que quieres eliminar «{{game.game_name}}»? Esta acción no se puede deshacer.">
                        <button type="submit" class="btn btn-danger">
                            {{#if isOwner}}🗑️ Eliminar{{else}}🛡️ Eliminar como moderador{{/if}}
                        </button>
                    </form>
                {{/if}}

            </div>

        </div>

    </div>

</main>
