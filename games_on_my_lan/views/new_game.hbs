{{> header activeNew=true}}

<main class="main-panel container mt-5">

    <h1 class="text-secondary mb-4">
        ⬆️ Subir nuevo juego
    </h1>

    <form
        action="/games"
        method="POST"
        enctype="multipart/form-data">

        <div class="row g-4">

            <div class="col-md-4 text-center">

                <label class="thumb-dropzone" for="thumbnail" title="Haz clic para elegir una imagen">
                    <img
                        src="/img/default_game.png"
                        alt="Vista previa de la miniatura"
                        class="thumbnail mb-2"
                        id="thumbnailPreview">
                    <span class="thumb-hint">📷 Cambiar imagen</span>
                </label>

                <input
                    type="file"
                    class="form-control mt-2"
                    name="thumbnail"
                    id="thumbnail"
                    accept=".png">

                <p class="field-hint">Formato PNG. Cuadrada se ve mejor.</p>

            </div>

            <div class="col-md-8">

                <h2 class="text-primary" style="font-size:1.3rem;">
                    Información del juego
                </h2>

                <div class="mb-3">
                    <label class="form-label">Nombre del juego</label>
                    <input
                        type="text"
                        class="form-control"
                        name="game_name"
                        placeholder="Ej: Naval Warfare"
                        required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea
                        class="form-control"
                        name="game_description"
                        id="gameDescription"
                        maxlength="400"
                        rows="3"
                        placeholder="Cuenta de qué trata tu juego..."></textarea>
                    <div class="char-counter"><span id="descCount">0</span>/400</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Archivo del juego (.zip)</label>
                    <div class="file-drop" id="gameFileDrop">
                        <span class="file-drop-icon">📦</span>
                        Arrastra tu .zip aquí o haz clic para elegirlo
                        <input
                            type="file"
                            name="gameFile"
                            id="gameFile"
                            accept=".zip"
                            required>
                        <span class="file-drop-name" id="gameFileName"></span>
                    </div>
                    <p class="field-hint">Debe contener tu juego web (HTML/JS/CSS) comprimido en un .zip.</p>
                </div>

                <div class="mb-4">
                    <label class="form-label">Archivo principal</label>
                    <input
                        type="text"
                        class="form-control"
                        name="entry_file"
                        value="index.html"
                        required>
                    <p class="field-hint">El archivo que se abrirá al jugar (normalmente index.html).</p>
                </div>

                <button
                    class="btn btn-primary"
                    type="submit">
                    ⬆️ Registrar juego
                </button>
            </div>
        </div>
    </form>
</main>
<script src="/js/newGame.js"></script>
