<header class="header bg-primary p-3 d-flex flex-column flex-md-row align-items-center justify-content-between">

    <img src="/img/logo.png" 
         alt="GamesOnMyLan Logo" 
         class="logo mb-2 mb-md-0">

    <h1 class="text-primary">
        GamesOnMyLan
    </h1>

    <nav class="nav">

        <a class="nav-link text-tertiary" href="/">
            Inicio
        </a>

        <a class="nav-link text-tertiary" href="/games/new">
            Nuevo
        </a>

        {{#if user}}
            <a class="nav-link text-tertiary" href="/profile">
                Perfil
            </a>
        {{else}}
            <a class="nav-link text-tertiary" href="/login">
                Ingresar
            </a>
        {{/if}}
    </nav>
</header>

<main class="main-panel container mt-5">

    <h1 class="text-secondary">
        Usuarios registrados
    </h1>

    <div class="table-responsive mt-4">

        <table class="table table-dark table-hover align-middle">

            <tbody>

            {{#each users}}
                <tr>
                    <td>
                    </td>

                    <td class="text-primary">
                        {{username}}
                    </td>

                    <td>
                        {{role_name}}
                    </td>

                    <td>
                        {{registered_at}}
                    </td>
                </tr>

            {{else}}

                <tr>
                    <td colspan="5" class="text-center">
                        No hay usuarios registrados.
                    </td>
                </tr>

            {{/each}}

            </tbody>
        </table>
    </div>
</main>