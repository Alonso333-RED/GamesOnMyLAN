{{> header activeGames=true}}

<main class="main-panel container mt-5">

    <h1 class="text-secondary mb-4">
        ✎ Editar: {{game.game_name}}
    </h1>

    <form
        action="/games/{{game.id_game}}?_method=PUT"
        method="POST"
        enctype="multipart/form-data">

        <div class="row g-4">

            <div class="col-md-4 text-center">

                <label class="thumb-dropzone" for="thumbnail" title="Haz clic para cambiar la imagen">
                    <img
                        src="/thumbnails/{{game.id_game}}.png"
                        alt="Vista previa de la miniatura"
                        class="thumbnail mb-2"
                        id="thumbnailPreview"
                        onerror="this.onerror=null;this.src='/img/default_game.png';">
                    <span class="thumb-hint">📷 Cambiar imagen</span>
                </label>

                <input
                    type="file"
                    class="form-control mt-2"
                    name="thumbnail"
                    id="thumbnail"
                    accept=".png"
                    data-max-mb="5">
                <p class="field-hint">Formato PNG, máximo 5 MB.</p>

            </div>

            <div class="col-md-8">

                <h2 class="text-primary" style="font-size:1.3rem;">
                    Información del juego
                </h2>

                <div class="mb-3">
                    <label class="form-label">Nombre del juego</label>
                    <input
                        type="text"
                        class="form-control"
                        name="game_name"
                        value="{{game.game_name}}"
                        required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea
                        class="form-control"
                        name="game_description"
                        id="gameDescription"
                        maxlength="400"
                        rows="3">{{game.game_description}}</textarea>
                    <div class="char-counter"><span id="descCount">0</span>/400</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Archivo del juego (.zip)</label>
                    <div class="file-drop" id="gameFileDrop">
                        <span class="file-drop-icon">📦</span>
                        Arrastra un nuevo .zip aquí o haz clic para reemplazarlo
                        <input
                            type="file"
                            name="gameFile"
                            id="gameFile"
                            accept=".zip">
                        <span class="file-drop-name" id="gameFileName"></span>
                    </div>
                    <p class="field-hint">Déjalo vacío si no quieres reemplazar los archivos del juego.</p>
                </div>

                <div class="mb-4">
                    <label class="form-label">Archivo principal</label>
                    <input
                        type="text"
                        class="form-control"
                        name="entry_file"
                        value="{{game.entry_file}}"
                        required>
                </div>

                <button
                    class="btn btn-primary"
                    type="submit">
                    💾 Guardar cambios
                </button>
            </div>
        </div>
    </form>
</main>
<script src="/js/newGame.js"></script>
