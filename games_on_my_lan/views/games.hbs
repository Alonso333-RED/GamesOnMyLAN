{{> header activeGames=true}}

<main class="main-panel container mt-5">

    <h1 class="text-secondary">
        Juegos registrados
    </h1>

    <div class="gallery-toolbar">

        <div class="search-wrap">
            <span class="search-icon">🔍</span>
            <input class="mySearcher"
                type="search"
                id="gameSearch"
                placeholder="Buscar por nombre o autor..."
                autocomplete="off">
        </div>

        <span class="result-count" id="resultCount"></span>

    </div>

    <div class="game-grid" id="gameGrid">

        {{#each games}}
            <article class="game-card" data-name="{{game_name}}" data-author="{{author_name}}">

                <div class="game-card-media">
                    <img
                        src="/thumbnails/{{id_game}}.png"
                        alt="{{game_name}}"
                        loading="lazy"
                        onerror="this.onerror=null;this.src='/img/default_game.png';">

                    <div class="game-card-overlay">
                        <a href="/game-files/{{id_game}}/{{entry_file}}" class="btn btn-primary">
                            ▶️ Jugar
                        </a>
                        <a href="/games/game-details/{{id_game}}" class="btn btn-outline-light">
                            Detalles
                        </a>
                    </div>
                </div>

                <div class="game-card-body">
                    <p class="game-card-title" title="{{game_name}}">{{game_name}}</p>
                    <p class="game-card-author">por {{author_name}}</p>
                    <span class="game-card-date">Actualizado: {{updated_at}}</span>
                </div>

            </article>
        {{else}}
            <div class="empty-state">
                <span class="empty-icon">🎮</span>
                Aún no hay juegos registrados.<br>
                ¡Sé el primero en <a href="/games/new">subir uno</a>!
            </div>
        {{/each}}

    </div>

    <div class="empty-state" id="noResults" style="display:none;">
        <span class="empty-icon">🔎</span>
        No se encontraron juegos que coincidan con tu búsqueda.
    </div>

</main>

<script src="/js/games.js"></script>
