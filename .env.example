# IP de tu máquina en la red local. En Linux: hostname -I
HOST_IP=192.168.1.50

# Base de datos. Elige esto ANTES del primer arranque.
DB_USER=goml
DB_PASSWORD=cambia_esta_clave
DB_DATABASE=goml_db

# Puertos de GOML y de los juegos
APP_PORT=3000
GAMES_PORT=3001

# Permitir que cualquiera cree una cuenta (true / false)
GUEST_REGISTER=true

# Propietario inicial (solo se usa si la base no tiene usuarios).
OWNER_USER=admin
OWNER_PASSWORD=

# Opcional: GOML genera una clave de sesión al azar la primera vez.
# Descomenta y rellena solo si quieres usar una propia.
# SESSION_SECRET=